# Entorno de ejecución (development, test, production)
NODE_ENV=development

# Puerto del servidor API backend
PORT=4000

# Secreto JWT (Obligatorio en producción; debe ser una cadena aleatoria segura de al menos 32 caracteres)
JWT_SECRET=reemplazar_con_secreto_seguro_y_aleatorio_32chars

# Dominios permitidos para CORS (separados por coma). En producción se requiere especificación explícita.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Directorio raíz de almacenamiento (Por defecto en dev: ./storage relativo a backend)
# STORAGE_DIR=/ruta/absoluta/a/storage

# Ruta específica del archivo SQLite (Por defecto en dev: ./storage/data.db relativo a backend)
# DB_PATH=/ruta/absoluta/a/storage/data.db

# Directorio de almacenamiento de PDF de proformas (Por defecto en dev: ./storage/proformas)
# PROFORMA_DIR=/ruta/absoluta/a/storage/proformas

# Directorio de respaldos SQLite (Por defecto en dev: ./storage/backups)
# BACKUP_DIR=/ruta/absoluta/a/storage/backups

# Configuración opcional de cuenta administradora inicial
ADMIN_EMAIL=admin@lolo
# ADMIN_PASSWORD=contrasena_inicial_para_rotacion_manual

# Configuración opcional de servidor de correo SMTP para envío de proformas
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario@ejemplo.com
# SMTP_PASS=secretos_smtp
# SMTP_FROM=soporte@ejemplo.com
